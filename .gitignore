# Python
__pycache__/
*.py[cod]
.venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
dist/
build/

# Secrets and local config — never commit
.env
homeassistant/secrets.yaml
esphome/secrets.yaml
deploy/.env

# Personal data — this repo is PUBLIC. Real drives, fills, photos and
# GPS tracks live on the Pi or in data/, never in git.
data/
*.numbers
*.heic
*.HEIC
*.jpg
*.jpeg
scans/raw/

# Home Assistant runtime state — HA writes these into its bind-mounted /config.
# .storage holds auth tokens, Companion app registrations and integration
# credentials. tests/test_repo_privacy.py guards this list.
homeassistant/.storage/
homeassistant/.cloud/
homeassistant/deps/
homeassistant/tts/
homeassistant/home-assistant_v2.db*
homeassistant/home-assistant.log*
homeassistant/.HA_VERSION
homeassistant/.ha_run.lock
# blueprints/ holds HA's bundled defaults, written on first start.
homeassistant/blueprints/
homeassistant/www/
homeassistant/*.db
homeassistant/*.log

# Runtime state
deploy/volumes/
esphome/.esphome/

# Tooling
.DS_Store
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.lock
