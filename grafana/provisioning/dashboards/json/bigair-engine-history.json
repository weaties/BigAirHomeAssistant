{
  "id": null,
  "uid": "bigair-engine-history",
  "title": "Engine history",
  "tags": [
    "bigair"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "description": "First three history signals. Values are only meaningful once the source PIDs are VERIFIED in docs/pid-register.md.",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Fuel rate",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-van-raw"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "gph",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-van-raw"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"fuel_rate_gph\") FROM \"fuel\" WHERE $timeFilter GROUP BY time($__interval) fill(null)"
        }
      ],
      "description": "Engine fuel rate in gal/h, from the fuel model (any method)."
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Engine temperatures",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-van-raw"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Coolant"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3e8ed0"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Oil"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e0a526"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Outside"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8b8d98"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-van-raw"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"coolant_temp_c\") FROM \"engine\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "alias": "Coolant"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-van-raw"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"oil_temp_c\") FROM \"engine\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "alias": "Oil"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-van-raw"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"ambient_temp_c\") FROM \"vehicle\" WHERE $timeFilter GROUP BY time($__interval) fill(null)",
          "alias": "Outside"
        }
      ],
      "description": "Coolant (05), oil (5C) and outside air (46), polled every ~10 s while the engine runs (#79)."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Battery voltage",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-van-raw"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "volt",
          "custom": {
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-van-raw"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"battery_v\") FROM \"vehicle\" WHERE $timeFilter GROUP BY time($__interval) fill(null)"
        }
      ],
      "description": "Starter battery via OBD control-module voltage (PID 42, UNVERIFIED)."
    }
  ]
}
