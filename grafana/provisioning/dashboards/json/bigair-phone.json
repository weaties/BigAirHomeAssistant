    {
      "id": 11,
      "type": "xychart",
      "title": "Speed vs economy",
      "description": "Every track point while moving (> 5 mph): where the van is most efficient.",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-van-history"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 31
