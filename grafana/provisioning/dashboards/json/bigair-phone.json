{
  "id": null,
  "uid": "bigair-phone",
  "title": "Van (phone)",
  "description": "Phone-width companion to the HA Van dashboard (#65). Open with ?kiosk on the van Wi-Fi.",
  "tags": [
    "bigair",
    "phone"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "graphTooltip": 1,
  "refresh": "10s",
  "liveNow": false,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m"
    ]
  },
  "annotations": {
    "list": [
      {
        "name": "Fill-ups",
        "datasource": {
          "type": "influxdb",
          "uid": "influx-van-history"
        },
        "enable": true,
        "iconColor": "#30a46c",
        "query": "SELECT \"gallons\", \"price_per_gal\" FROM \"fill_up\" WHERE $timeFilter AND \"status\" = 'confirmed'",
        "textColumn": "gallons"
      }
    ]
  },
  "links": [
    {
      "title": "HA Van dashboard",
      "type": "link",
      "url": "http://bigair-ha.local:8123/bigair-van/drive",
      "targetBlank": true,
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Now",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "gauge",
      "title": "Tank",
      "description": "Fuel model tank level. Hidden while the fuel data is stale; check Status for calibrating.",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-van-raw"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-van-raw"
          },
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT last(\"tank_gal\") AS \"Tank\", last(\"stale\") AS \"stale\" FROM \"fuel\" WHERE time > now() - 30d"
        }
      ],
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "type": "exclude",
            "match": "any",
            "filters": [
              {
                "fieldName": "stale",
                "config": {
                  "id": "equal",
                  "options": {
                    "value": true
                  }
                }
              }
            ]
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: gal",
          "decimals": 1,
          "min": 0,
          "max": 47,
          "noValue": "No fresh data",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#e5484d",
                "value": null
              },
              {
                "color": "#f5a524",
                "value": 8
              },
              {
                "color": "#30a46c",
                "value": 16
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Tank$/",
          "values": false
        },
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "minVizHeight": 75,
        "minVizWidth": 75,
        "sizing": "auto",
        "orientation": "auto"
      }
    },
    {
