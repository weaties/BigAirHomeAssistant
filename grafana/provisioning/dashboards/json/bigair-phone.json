          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-van-history"
          },
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT mean(\"speed_mph\") AS \"speed_mph\", mean(\"mpg_30s\") AS \"mpg_30s\" FROM \"track\" WHERE $timeFilter AND \"speed_mph\" > 5 AND \"mpg_30s\" > 0 GROUP BY time($__interval) fill(none)"
