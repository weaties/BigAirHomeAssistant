{
  "id": null,
  "uid": "bigair-mpg-map",
  "title": "MPG map",
  "tags": [
    "bigair"
  ],
  "timezone": "browser",
  "editable": true,
  "schemaVersion": 39,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "description": "Track coloured by 30 s smoothed mpg. Basemap tiles need internet; offline tiles are an M2 decision.",
  "panels": [
    {
      "id": 1,
      "type": "geomap",
      "title": "Track by mpg (30 s)",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-van-history"
      },
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-van-history"
          },
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT \"lat\", \"lon\", \"mpg_30s\", \"speed_mph\" FROM \"track\" WHERE $timeFilter"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 8,
          "max": 25,
          "unit": "none",
          "decimals": 1,
          "color": {
            "mode": "continuous-RdYlGr"
          }
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "fit",
          "lat": 0,
          "lon": 0,
          "zoom": 5
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true
        },
        "basemap": {
          "type": "default",
          "name": "Basemap"
        },
        "layers": [
          {
            "type": "markers",
            "name": "mpg",
            "tooltip": true,
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "config": {
              "showLegend": true,
              "style": {
                "size": {
                  "fixed": 4
                },
                "color": {
                  "field": "mpg_30s",
                  "fixed": "grey"
                },
                "opacity": 0.8,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                }
              }
            }
          }
        ]
      }
    },
    {
      "id": 2,
      "type": "geomap",
      "title": "Track by grade",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-van-history"
      },
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 20
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-van-history"
          },
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT \"lat\", \"lon\", \"grade_pct\", \"mpg_30s\", \"alt_m\" FROM \"track\" WHERE $timeFilter"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": -8,
          "max": 8,
          "unit": "percent",
          "decimals": 1,
          "color": {
            "mode": "continuous-BlYlRd"
          }
        },
        "overrides": []
      },
      "options": {
        "view": {
          "id": "fit",
          "lat": 0,
          "lon": 0,
          "zoom": 5
        },
        "controls": {
          "showZoom": true,
          "mouseWheelZoom": true
        },
        "basemap": {
          "type": "default",
          "name": "Basemap"
        },
        "layers": [
          {
            "type": "markers",
            "name": "grade",
            "tooltip": true,
            "location": {
              "mode": "coords",
              "latitude": "lat",
              "longitude": "lon"
            },
            "config": {
              "showLegend": true,
              "style": {
                "size": {
                  "fixed": 4
                },
                "color": {
                  "field": "grade_pct",
                  "fixed": "grey"
                },
                "opacity": 0.8,
                "symbol": {
                  "mode": "fixed",
                  "fixed": "img/icons/marker/circle.svg"
                }
              }
            }
          }
        ]
      },
      "description": "Road grade over a 400 m window: blue downhill, red uphill (#78)."
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Elevation and grade",
      "description": "GPS elevation and road grade over a 400 m window (#78). Grade is blank until the van has covered 400 m, and while parked.",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-van-history"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-van-history"
          },
          "rawQuery": true,
          "resultFormat": "time_series",
          "query": "SELECT mean(\"alt_m\") * 3.28084 AS \"Elevation\", mean(\"grade_pct\") AS \"Grade\" FROM \"track\" WHERE $timeFilter GROUP BY time($__interval) fill(null)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "never",
            "spanNulls": false,
            "fillOpacity": 0,
            "axisBorderShow": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Elevation"
            },
            "properties": [
              {
                "id": "unit",
                "value": "lengthft"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#8b8d98"
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 15
              },
              {
                "id": "custom.axisPlacement",
                "value": "left"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Grade"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "min",
                "value": -10
              },
              {
                "id": "max",
                "value": 10
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#e0a526"
                }
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      }
    },
    {
      "id": 4,
      "type": "xychart",
      "title": "Grade vs economy",
      "description": "Track points above 30 mph (so speed doesn't dominate): how much a climb costs and a descent gives back (#78).",
      "datasource": {
        "type": "influxdb",
        "uid": "influx-van-history"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 48
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influx-van-history"
          },
          "rawQuery": true,
          "resultFormat": "table",
          "query": "SELECT mean(\"grade_pct\") AS \"grade_pct\", mean(\"mpg_30s\") AS \"mpg_30s\" FROM \"track\" WHERE $timeFilter AND \"speed_mph\" > 30 AND \"mpg_30s\" > 0 GROUP BY time($__interval) fill(none)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "#e0a526"
          },
          "custom": {
            "show": "points",
            "pointSize": {
              "fixed": 8
            },
            "pointShape": "circle",
            "fillOpacity": 60,
            "axisBorderShow": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "grade_pct"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              },
              {
                "id": "displayName",
                "value": "Grade"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "min",
                "value": -8
              },
              {
                "id": "max",
                "value": 8
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "mpg_30s"
            },
            "properties": [
              {
                "id": "unit",
                "value": "suffix: mpg"
              },
              {
                "id": "displayName",
                "value": "mpg"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 30
              }
            ]
          }
        ]
      },
      "interval": "10s",
      "maxDataPoints": 4000,
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            }
          }
        }
      ],
      "options": {
        "mapping": "auto",
        "series": [
          {}
        ],
        "legend": {
          "showLegend": false,
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      }
    }
  ]
}
