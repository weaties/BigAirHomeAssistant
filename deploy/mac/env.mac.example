# Mac copy of the planner + HA relay (#105). Copy to deploy/.env.mac (gitignored)
# and run deploy/mac/setup.sh. Nothing on the Pi depends on any of this.

# The Pi's Tailscale address (tailscale status). Tank comes from its Mosquitto;
# HA and Grafana are relayed to it.
PI_TS_IP=100.x.y.z

# This Mac's Tailscale address. The planner and relays listen only here, so they're
# reachable over the tailnet but not on whatever Wi-Fi the Mac is on.
MAC_TS_IP=100.x.y.z

# Same keys as the Pi's deploy/.env. setup.sh can copy them over SSH (--copy-keys).
GOOGLE_MAPS_API_KEY=
EIA_API_KEY=
ANTHROPIC_API_KEY=
# The Mac keeps its own spend ledger, separate from the Pi's: keep this cap small.
CLAUDE_MONTHLY_CAP_USD=5
PLANNER_DAILY_LIMIT=20

# The vault POI folder, read in place (no Syncthing needed on the Mac).
POI_DIR=
# Byways / public land / iOverlander copies (setup.sh --copy-data fetches the Pi's).
PLANNER_DATA_DIR=
TZ=America/Los_Angeles
