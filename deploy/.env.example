# deploy/bootstrap.sh copies this to deploy/.env (gitignored, mode 600) and
# fills in generated secrets. Never commit deploy/.env.
TZ=America/Denver

INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-me-long
INFLUX_ADMIN_TOKEN=change-me-admin-token
# Created by deploy/bootstrap.sh in InfluxDB; leave empty here.
# Grafana: read-only on van_raw + van_history. bigair: read/write on both.
INFLUX_GRAFANA_TOKEN=
INFLUX_BIGAIR_TOKEN=

GRAFANA_ADMIN_PASSWORD=change-me

MQTT_HOST=mosquitto
MQTT_PORT=1883
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=bigair

# Bluetooth GPS (host gpsd, Decision #28). Find the MAC with
# `bluetoothctl --timeout 20 scan on` then `bluetoothctl devices`, and the channel with
# `sdptool browse <MAC>`. Leave GPS_BT_MAC empty to skip GPS setup.
GPS_BT_MAC=
GPS_BT_CHANNEL=1

# Dash display server (Decision #29). The LilyGo runs the eink-screen firmware,
# which sends ONE compiled-in Bearer key to every server it talks to. Set this to
# that same key (HELMLOG_API_KEY in ~/src/eink-screen/include/config.h) so one
# unit works on the boat (HelmLog) and in the van. Empty = display not started.
DISPLAY_API_KEY=
DISPLAY_REFRESH_SECONDS=60
DISPLAY_FULL_REFRESH_SECONDS=600
# Drive testing: show Pi supply / van battery voltage on the dash display instead of
# the trip sparkline (needs deploy/host/bigair-debug.service). Empty = off.
DISPLAY_DEBUG_FILE=

# Tailscale (Decision #30): remote access to this Pi from Dan's tailnet. Optional;
# the van works fully offline without it. An auth key (tailnet admin → Settings →
# Keys) joins non-interactively; without one, the bootstrap prints the login command.
TAILSCALE_ENABLE=false
TAILSCALE_AUTHKEY=
