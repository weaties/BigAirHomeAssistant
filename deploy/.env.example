# deploy/bootstrap.sh copies this to deploy/.env (gitignored, mode 600) and
# fills in generated secrets. Never commit deploy/.env.
TZ=America/Denver

INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-me-long
INFLUX_ADMIN_TOKEN=change-me-admin-token
# Created by deploy/bootstrap.sh in InfluxDB; leave empty here.
# Grafana: read-only on van_raw + van_history. bigair: read/write on both.
INFLUX_GRAFANA_TOKEN=
INFLUX_BIGAIR_TOKEN=

GRAFANA_ADMIN_PASSWORD=change-me

MQTT_HOST=mosquitto
MQTT_PORT=1883
# WiCAN ELM327 over TCP (Decision #33); fixed address reserved on the van router
WICAN_HOST=192.168.8.106
WICAN_PORT=35000
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=bigair

# Bluetooth GPS (host gpsd, Decision #28). Find the MAC with
# `bluetoothctl --timeout 20 scan on` then `bluetoothctl devices`, and the channel with
# `sdptool browse <MAC>`. Leave GPS_BT_MAC empty to skip GPS setup.
GPS_BT_MAC=
GPS_BT_CHANNEL=1

# Dash display server (Decision #29). The LilyGo runs the eink-screen firmware,
# which sends ONE compiled-in Bearer key to every server it talks to. Set this to
# that same key (HELMLOG_API_KEY in ~/src/eink-screen/include/config.h) so one
# unit works on the boat (HelmLog) and in the van. Empty = display not started.
DISPLAY_API_KEY=
DISPLAY_REFRESH_SECONDS=60
DISPLAY_FULL_REFRESH_SECONDS=600
# Pi supply and uptime on the dash Van screen (needs deploy/host/bigair-debug.service).
# Set to /run/bigair/debug.json; empty = those rows show "--".
DISPLAY_DEBUG_FILE=
# Keyless browser preview of the dash screens: loopback only, published to the
# tailnet by bootstrap's `tailscale serve` (Decision #37).
DISPLAY_PREVIEW_PORT=8091

# Tailscale (Decision #30): remote access to this Pi from Dan's tailnet. Optional;
# the van works fully offline without it. An auth key (tailnet admin → Settings →
# Keys) joins non-interactively; without one, the bootstrap prints the login command.
TAILSCALE_ENABLE=false
TAILSCALE_AUTHKEY=

# Grafana dashboards without a login (read-only Viewer) for the phone (Decision #38).
GRAFANA_ANONYMOUS=true

# Fuel-stop planner, live mode (docs/fuel-plan.md, #71). Google key: Routes API +
# Places API (New), restricted to those two, with a budget alert. EIA key is
# free (eia.gov/opendata); empty = DEMO_KEY (rate-limited).
GOOGLE_MAPS_API_KEY=
EIA_API_KEY=
# Trip planner page (#75, port 8092): the most plans per day (each one is about
# 20–30 billed Google searches). Empty GOOGLE_MAPS_API_KEY = the page loads but can't plan.
PLANNER_DAILY_LIMIT=20

# Points of interest for the trip planner (#88): Dan's vault POI folder, synced to
# this Pi by Syncthing (receive-only; docs/hardware/syncthing-poi.md). The planner
# mounts it read-only. The notes are personal: keep the folder out of git (data/ is
# gitignored). SYNCTHING_ENABLE=true has the bootstrap install and start Syncthing.
SYNCTHING_ENABLE=false
POI_HOST_DIR=../data/poi
# Slow mode's travel rules (#90) default to Dan's: ≤300 mi a day (a ceiling, not a
# target), leave 10:00, arrive by 15:00, no driving after dark, avoid interstates.
# To change them or weight POI tags, write data/bigair/travel-rules.yaml
# (docs/fuel-plan.md → Slow mode).
# Claude in the planner (#89): "Why this way?" and suggestions you accept or dismiss.
# Key from console.anthropic.com (set a monthly spend limit there too). Empty =
# Claude features show "not set up" and everything else works. bigair stops
# starting new questions near CLAUDE_MONTHLY_CAP_USD (its own estimate).
ANTHROPIC_API_KEY=
CLAUDE_MONTHLY_CAP_USD=25
# Evening briefing (#94): local time Claude writes tomorrow's drive and HA notifies the
# phone (needs mobile_app_notify in homeassistant/secrets.yaml). Empty = off.
BRIEFING_TIME=19:00
PLANNER_URL=http://bigair-ha.local:8092/
# Claude Code on the Pi for SSH sessions (bootstrap installs it; log in yourself).
CLAUDE_CODE_ENABLE=false
# Destination discovery (#91) also reads, if present: data/bigair/ioverlander/*.gpx
# (your iOverlander exports) and data/bigair/public-land.geojson (BLM/USFS units).
# Slow mode prefers National Scenic Byways if data/bigair/byways.geojson exists (#100).

# Victron Instant Readout over BLE (#109). One MAC + KEY pair per device, from
# VictronConnect: device → gear → Product info → Instant readout details → Show.
# Any VICTRON_<NAME>_MAC / VICTRON_<NAME>_KEY pair is read; the key changes if the
# device's Bluetooth PIN is changed.
#VICTRON_BMV_MAC=
#VICTRON_BMV_KEY=
#VICTRON_SOLAR_MAC=
#VICTRON_SOLAR_KEY=
#VICTRON_ORION_MAC=
#VICTRON_ORION_KEY=

# Nightly backups (#111). bootstrap.sh generates this; keep a copy in your password
# manager. Without it the encrypted backups can't be read.
RESTIC_PASSWORD=
