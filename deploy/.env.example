# Copy to deploy/.env (gitignored). Generate real secrets; never commit them.
TZ=America/Denver

INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=change-me-long
INFLUX_ADMIN_TOKEN=change-me-admin-token
INFLUX_GRAFANA_TOKEN=change-me-read-only-token  # read-only token for van_raw + van_history
INFLUX_BIGAIR_TOKEN=change-me-write-token       # write token for bigair

GRAFANA_ADMIN_PASSWORD=change-me

MQTT_HOST=mosquitto
MQTT_PORT=1883
INFLUX_URL=http://influxdb:8086
INFLUX_ORG=bigair

GPS_DEVICE=/dev/ttyACM0   # UNVERIFIED — depends on the USB GPS model
